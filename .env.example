DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_NAME=your-database-name

# Email (Gmail SMTP) — for delegation notifications
SMTP_USER=yourname@gmail.com
SMTP_PASS=your-gmail-app-password

# ── Security (see server.js) ──────────────────────────────────────────────────
# Signs the session cookie. REQUIRED in production: without it the server falls
# back to a random per-boot secret and every restart signs all users out.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=

# Password for the /developer panel. Sent in the x-developer-secret header.
# Leave BLANK to disable that panel entirely (it fails closed).
DEVELOPER_SECRET=

# Unlocks /api/master (the enable/disable-the-whole-app page). Leave BLANK
# unless you actually need it — blank means the page is unreachable.
MASTER_KEY=

# Unlocks the one-time /api/migrate user-import bootstrap. Should stay BLANK:
# that route overwrites the users table from a hard-coded list.
MIGRATE_KEY=
